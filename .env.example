# Salin file ini menjadi .env lalu isi nilainya.
# File .env TIDAK BOLEH di-commit ke Git.

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Pakai "service_role" key (rahasia, hanya untuk server). JANGAN taruh di kode frontend.
SUPABASE_SERVICE_KEY=isi-service-role-key-di-sini

# Kunci acak untuk menandatangani cookie sesi.
# Buat dengan: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ganti-dengan-kunci-acak-panjang

# 1 = cookie hanya dikirim lewat HTTPS. Di Vercel otomatis 1 (tidak perlu diisi).
# Isi 0 saat mencoba di laptop/HP lewat http://.
COOKIE_SECURE=0

# Jika SUPABASE_URL/SUPABASE_SERVICE_KEY kosong, aplikasi di LAPTOP berjalan dalam MODE DEMO
# (di Vercel tidak diizinkan, aplikasi akan menolak berjalan):
# data disimpan sementara di memori server (hilang saat server dimatikan).
# Siswa masuk cukup dengan nama panggilan.
